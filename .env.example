# Optional later integrations. None of these are required at runtime.
# The interview works offline from the local 10 prompts and browser storage.

# Transcription webhook (after the session, never a live dual-record).
VITE_TRANSCRIPTION_WEBHOOK_URL=
VITE_TRANSCRIPTION_CALLBACK_URL=https://example.invalid/webhooks/perhemuistelut/transcription

# Extra follow-ups / archived answers. Local 10 prompts stay canonical.
VITE_QUESTIONS_API_URL=
VITE_QUESTIONS_API_KEY=
VITE_ARCHIVE_API_URL=
VITE_ARCHIVE_API_KEY=

# Poke inbound reminders for "palaa myöhemmin". Not a question-fetch API.
# POST https://poke.com/api/v1/inbound/api-message — Poke does not return Q&A.
VITE_POKE_API_KEY=

# Optional LLM for personalized follow-ups on theme change. Template fallback if unset.
VITE_LLM_URL=
VITE_LLM_API_KEY=
VITE_PERSONALIZE_URL=
VITE_PERSONALIZE_API_KEY=
